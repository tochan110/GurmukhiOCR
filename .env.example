# Flask
SECRET_KEY=generate-a-long-random-string-for-production
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Optional but recommended for faster JWT verification:
SUPABASE_JWT_SECRET=your-jwt-secret
# Optional: bucket for per-page OCR JSON (gzip). Defaults to gbucket.
# Allow application/json and application/gzip in that bucket's MIME settings.
# SUPABASE_JSON_BUCKET=ocr-json

# Google Cloud Vision (server default key path — file must NOT be committed)
GURMUKHI_OCR_KEY_PATH=/absolute/path/to/service-account.json
# Or use the standard GCP variable (only if the file exists on the server):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# Render: add a Secret File (e.g. google-ocr-key.json), then point one of these at it:
# GURMUKHI_OCR_KEY_PATH=/etc/secrets/google-ocr-key.json

# OCR worker pool (optional)
# OCR_MAX_WORKERS=8
# Parallel per-page JSON uploads during bundle import (default up to 10; set 1 for sequential).
# IMPORT_MAX_WORKERS=10

# CORS for POST /process (optional; comma-separated origins, or * for any)
# CORS_PROCESS_ORIGIN=https://your-frontend.example.com

# Stripe (one-time Checkout for paid OCR credits)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
